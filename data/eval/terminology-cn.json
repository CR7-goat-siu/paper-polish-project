{
  "schema_version": "1.0",
  "suite": "terminology",
  "language": "cn",
  "description": "中文术语退化用例：指标为术语召回率与自造词拦截率。",
  "cases": [
    {
      "id": "cterm-001",
      "text": "该模型采用褶积网络提取特征，学习速率设为 0.001。",
      "expect_canonical": [
        "卷积",
        "学习率"
      ],
      "expect_removed": [
        "褶积",
        "学习速率"
      ],
      "reference": "该模型采用卷积网络提取特征，学习率设为 0.001。"
    },
    {
      "id": "cterm-002",
      "text": "使用批规范化缓解过度拟合问题。",
      "expect_canonical": [
        "批量归一化",
        "过拟合"
      ],
      "expect_removed": [
        "批规范化",
        "过度拟合"
      ],
      "reference": "使用批量归一化缓解过拟合问题。"
    },
    {
      "id": "cterm-003",
      "text": "通过误差反向传播与数据增广提升概括能力。",
      "expect_canonical": [
        "反向传播",
        "数据增强",
        "泛化"
      ],
      "expect_removed": [
        "误差反向传播",
        "数据增广",
        "概括能力"
      ],
      "reference": "通过反向传播与数据增强提升泛化能力。"
    },
    {
      "id": "cterm-004",
      "text": "网络采用注意机制与神经元网络结构。",
      "expect_canonical": [
        "注意力机制",
        "神经网络"
      ],
      "expect_removed": [
        "注意机制",
        "神经元网络"
      ],
      "reference": "网络采用注意力机制与神经网络结构。"
    },
    {
      "id": "cterm-005",
      "text": "损失函数采用误差函数进行设计。",
      "expect_canonical": [
        "损失函数"
      ],
      "expect_removed": [
        "误差函数"
      ],
      "reference": "损失函数采用规范设计。"
    },
    {
      "id": "cterm-006",
      "text": "对预训练模型执行精调，并评估其概括能力。",
      "expect_canonical": [
        "微调",
        "泛化"
      ],
      "expect_removed": [
        "精调",
        "概括能力"
      ],
      "reference": "对预训练模型执行微调，并评估其泛化能力。"
    },
    {
      "id": "cterm-007",
      "text": "在标杆数据集上验证了深度神经网络学习模型的有效性。",
      "expect_canonical": [
        "基准",
        "深度学习"
      ],
      "expect_removed": [
        "标杆数据集",
        "深度神经网络学习"
      ],
      "reference": "在基准数据集上验证了深度学习模型的有效性。"
    },
    {
      "id": "cterm-008",
      "text": "编码器通过小波转换提取时域特征，并使用独立成份分析去除伪差。",
      "expect_canonical": [
        "小波变换",
        "独立成分分析",
        "伪迹"
      ],
      "expect_removed": [
        "小波转换",
        "独立成份分析",
        "伪差"
      ],
      "reference": "编码器通过小波变换提取时域特征，并使用独立成分分析去除伪迹。"
    }
  ]
}
